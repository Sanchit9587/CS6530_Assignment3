# ============================================================
# SITE A environment — filled in by Student A
# ============================================================
                                                                                                                
SITE_ROLE=a                                                     

# --- WAN (LAN-facing) addresses: actual mutually-reachable IPs ---
MY_WAN_IP=10.229.244.178
PEER_WAN_IP=10.229.244.9    # <-- fill in Student B's VM bridged IP once his VM is up
WAN_IFACE=wlp1s0              # the interface your WAN IP above lives on (`ip addr` to confirm)
PEER_HOST_IP=10.2.0.10        # peer's protected-host IP inside his namespace (fixed by assignment)

# --- Protected-subnet / namespace addressing (fixed by assignment) ---
MY_GATEWAY_IP=10.1.0.1/24
MY_HOST_IP=10.1.0.10/24
MY_SUBNET=10.1.0.0/24
PEER_SUBNET=10.2.0.0/24

# --- Namespace / veth naming (used by netns-setup.sh) ---
NETNS_NAME=hostA
VETH_HOST=vethA-host
VETH_NS=vethA-ns

# --- IKE/ESP proposals (used for FR2-FR4, TR-4) ---
IKE_PROPOSAL=aes256-sha256-modp2048!
ESP_PROPOSAL=aes256-sha256!

# --- Roll numbers (UPPER CASE), fixed Site-A/Site-B order for PSK ---
# IMPORTANT: these two values must be IDENTICAL in site-a.env and
# site-b.env on both machines. Never swap the order per-site.
ROLL_NO_SITE_A=CE24B107      # <-- fill in Site A's real roll number, UPPER CASE
ROLL_NO_SITE_B=CE24B033      # <-- fill in Site B's real roll number, UPPER CASE

# --- PSK suffix (fixed by assignment spec, do not change) ---
PSK_SUFFIX=CS6530-IPsec-Assignment-2026